# Ejemplo de variables de entorno para el backend
# Copiar a `.env` y completar con valores reales (NO commitear `.env`)

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=REPLACE_ME
MERCADO_PAGO_ACCESS_TOKEN_SANDBOX=REPLACE_ME
MERCADO_PAGO_PUBLIC_KEY=REPLACE_ME
MERCADO_PAGO_PUBLIC_KEY_SANDBOX=REPLACE_ME
MERCADO_PAGO_USE_SANDBOX=false
MERCADO_PAGO_SUCCESS_URL=https://tu-frontend.vercel.app
MERCADO_PAGO_FAILURE_URL=https://tu-frontend.vercel.app
MERCADO_PAGO_PENDING_URL=https://tu-frontend.vercel.app
MERCADO_PAGO_NOTIFY_URL=https://tu-backend.onrender.com/webhook

# CORS (orígenes separados por coma)
ALLOW_ORIGINS=https://tu-frontend.vercel.app,http://localhost:5173

# Base de datos (opcional)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Otras variables opcionales
# ITEM_PRICE=15.0
